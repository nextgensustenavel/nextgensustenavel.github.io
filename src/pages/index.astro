---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="NextGen Sustentável torna os Objetivos de Desenvolvimento Sustentável mais acessíveis para crianças, adolescentes e jovens." data-i18n-attr="content:meta_description">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="NextGen Sustentável">
  <meta property="og:locale" content="pt_BR" data-i18n-attr="content:og_locale">
  <meta property="og:locale:alternate" content="en_US" data-i18n-attr="content:og_locale_alternate">
  <meta property="og:url" content="https://nextgensustentavel.org/">
  <meta property="og:title" content="NextGen Sustentável" data-i18n-attr="content:document_title">
  <meta property="og:description" content="NextGen Sustentável torna os Objetivos de Desenvolvimento Sustentável mais acessíveis para crianças, adolescentes e jovens." data-i18n-attr="content:meta_description">
  <meta property="og:image" content="https://nextgensustentavel.org/assets/logo.png">
  <meta property="og:image:alt" content="Logo do NextGen Sustentável" data-i18n-attr="content:logo_alt">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="NextGen Sustentável" data-i18n-attr="content:document_title">
  <meta name="twitter:description" content="NextGen Sustentável torna os Objetivos de Desenvolvimento Sustentável mais acessíveis para crianças, adolescentes e jovens." data-i18n-attr="content:meta_description">
  <meta name="twitter:image" content="https://nextgensustentavel.org/assets/logo.png">
  <meta name="twitter:image:alt" content="Logo do NextGen Sustentável" data-i18n-attr="content:logo_alt">
  <title>NextGen Sustentável</title>
  <link rel="canonical" href="https://nextgensustentavel.org/">
  <link rel="icon" type="image/png" href="/assets/logo.png" sizes="any">
  <link rel="apple-touch-icon" href="/assets/logo.png">
  <style is:global>
    :root {
      --green-950: #06251b;
      --green-900: #073826;
      --green-800: #0a4b32;
      --green-500: #20a86b;
      --green-100: #def8ea;
      --green-50: #f1fff6;
      --pink-700: #c82870;
      --pink-500: #f05292;
      --pink-100: #ffe7f1;
      --white: #ffffff;
      --line: rgba(6, 37, 27, 0.1);
      --line-strong: rgba(6, 37, 27, 0.18);
      --text: #092d20;
      --muted: #5a7569;
      --shadow: 0 28px 80px -18px rgba(7, 56, 38, 0.14), 0 10px 28px -10px rgba(7, 56, 38, 0.08);
      --glass-bg: linear-gradient(145deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.44) 55%, rgba(241, 255, 246, 0.56) 100%);
      --glass-bg-strong: linear-gradient(145deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.54) 52%, rgba(255, 247, 251, 0.62) 100%);
      --glass-rim: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(255, 255, 255, 0.56) 28%,
        rgba(32, 168, 107, 0.13) 50%,
        rgba(240, 82, 146, 0.13) 72%,
        rgba(255, 255, 255, 0.94) 100%
      );
      --glass-inset:
        inset 0 1.5px 1px rgba(255, 255, 255, 0.96),
        inset 1.5px 0 1px rgba(255, 255, 255, 0.68),
        inset 0 -1.5px 3px rgba(6, 37, 27, 0.045),
        inset 0 0 26px rgba(255, 255, 255, 0.38);
      --glass-blur: blur(26px) saturate(190%) brightness(1.03);
      --glass-blur-soft: blur(18px) saturate(175%) brightness(1.02);
      --spring-elastic: cubic-bezier(0.22, 1.28, 0.36, 1);
      --spring-smooth: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      box-sizing: border-box;
      letter-spacing: 0;
    }

    html {
      overflow-x: clip;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--text);
      background:
        linear-gradient(90deg, rgba(6, 37, 27, 0.03) 1px, transparent 1px),
        linear-gradient(180deg, rgba(6, 37, 27, 0.03) 1px, transparent 1px),
        linear-gradient(180deg, #ffffff 0%, #f8fff9 34%, #fff7fb 71%, #ffffff 100%);
      background-size: 56px 56px, 56px 56px, auto;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.5;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Ambient refractive backdrop so translucent Liquid Glass surfaces catch mint & blush light */
    .ambient-canvas {
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      position: fixed;
      z-index: -1;
    }

    .ambient-orb {
      border-radius: 999px;
      filter: blur(72px);
      opacity: 0.8;
      position: absolute;
      will-change: transform;
    }

    .ambient-orb.mint-top {
      animation: orb-drift-a 20s ease-in-out infinite alternate;
      background: radial-gradient(circle at 35% 35%, rgba(32, 168, 107, 0.25), rgba(222, 248, 234, 0.56) 55%, transparent 78%);
      height: 520px;
      left: -8%;
      top: -110px;
      width: 560px;
    }

    .ambient-orb.pink-top {
      animation: orb-drift-b 24s ease-in-out infinite alternate;
      background: radial-gradient(circle at 60% 40%, rgba(240, 82, 146, 0.22), rgba(255, 231, 241, 0.62) 56%, transparent 78%);
      height: 480px;
      right: -7%;
      top: 40px;
      width: 520px;
    }

    .ambient-orb.mint-mid {
      animation: orb-drift-b 26s ease-in-out infinite alternate-reverse;
      background: radial-gradient(circle, rgba(32, 168, 107, 0.18), rgba(222, 248, 234, 0.52) 58%, transparent 78%);
      height: 540px;
      right: 6%;
      top: 42%;
      width: 540px;
    }

    .ambient-orb.pink-low {
      animation: orb-drift-a 22s ease-in-out infinite alternate-reverse;
      background: radial-gradient(circle, rgba(240, 82, 146, 0.17), rgba(255, 231, 241, 0.55) 58%, transparent 78%);
      bottom: -120px;
      height: 520px;
      left: 8%;
      width: 580px;
    }

    .ambient-ribbon {
      border-radius: 999px;
      filter: blur(22px);
      opacity: 0.45;
      position: absolute;
      will-change: transform;
    }

    .ambient-ribbon.left {
      animation: ribbon-sway-left 18s ease-in-out infinite alternate;
      background: linear-gradient(180deg, rgba(32, 168, 107, 0.22), rgba(240, 82, 146, 0.18), rgba(222, 248, 234, 0.08));
      height: 420px;
      left: 7%;
      top: 22%;
      transform: rotate(-14deg);
      width: 120px;
    }

    .ambient-ribbon.right {
      animation: ribbon-sway-right 21s ease-in-out infinite alternate;
      background: linear-gradient(180deg, rgba(240, 82, 146, 0.2), rgba(32, 168, 107, 0.18), rgba(255, 231, 241, 0.08));
      bottom: 14%;
      height: 380px;
      right: 8%;
      transform: rotate(16deg);
      width: 110px;
    }

    @keyframes orb-drift-a {
      0% {
        transform: translate3d(0, 0, 0) scale(1);
      }

      50% {
        transform: translate3d(28px, 18px, 0) scale(1.06);
      }

      100% {
        transform: translate3d(-18px, 32px, 0) scale(0.96);
      }
    }

    @keyframes orb-drift-b {
      0% {
        transform: translate3d(0, 0, 0) scale(1);
      }

      50% {
        transform: translate3d(-26px, 22px, 0) scale(1.05);
      }

      100% {
        transform: translate3d(20px, -24px, 0) scale(0.97);
      }
    }

    @keyframes ribbon-sway-left {
      0% {
        transform: translate3d(0, 0, 0) rotate(-14deg) scaleY(1);
      }

      100% {
        transform: translate3d(16px, -28px, 0) rotate(-9deg) scaleY(1.08);
      }
    }

    @keyframes ribbon-sway-right {
      0% {
        transform: translate3d(0, 0, 0) rotate(16deg) scaleY(1);
      }

      100% {
        transform: translate3d(-18px, 26px, 0) rotate(11deg) scaleY(1.07);
      }
    }

    img {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Shared Liquid Glass specular rim & pointer-reactive glint */
    .nav-shell,
    .hero-logo,
    .eyebrow,
    .founder-strip,
    .workspace,
    .mission-panel,
    .metric,
    .timeline,
    .ods-palette,
    .method-block,
    .signal-board,
    .founder-card {
      position: relative;
    }

    .nav-shell::before,
    .hero-logo::before,
    .eyebrow::before,
    .founder-strip::before,
    .workspace::before,
    .mission-panel::before,
    .metric::before,
    .timeline::before,
    .ods-palette::before,
    .method-block::before,
    .signal-board::before,
    .founder-card::before {
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      background: var(--glass-rim);
      border-radius: inherit;
      content: "";
      inset: 0;
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask-composite: exclude;
      padding: 1.25px;
      pointer-events: none;
      position: absolute;
      z-index: 3;
    }

    .workspace::after,
    .method-block::after,
    .signal-board::after,
    .founder-card::after,
    .metric::after,
    .mission-panel::after {
      background: radial-gradient(
        340px circle at var(--glint-x, 22%) var(--glint-y, 14%),
        rgba(255, 255, 255, 0.52),
        rgba(255, 255, 255, 0.12) 42%,
        transparent 72%
      );
      border-radius: inherit;
      content: "";
      inset: 0;
      opacity: 0.72;
      pointer-events: none;
      position: absolute;
      transition: opacity 240ms ease;
      z-index: 0;
    }

    .method-block > *,
    .founder-card > *,
    .metric > *,
    .mission-panel > *,
    .signal-board > *,
    .workspace > * {
      position: relative;
      z-index: 1;
    }

    .skip-link {
      background: var(--green-950);
      border-radius: 999px;
      color: var(--white);
      left: 1rem;
      padding: 0.75rem 1rem;
      position: fixed;
      top: -5rem;
      z-index: 100;
    }

    .skip-link:focus {
      top: 1rem;
    }

    .site-header {
      left: 0;
      padding: 16px;
      position: fixed;
      right: 0;
      top: 0;
      transition: padding 320ms var(--spring-smooth);
      z-index: 40;
    }

    .site-header.is-scrolled {
      padding-top: 10px;
    }

    .nav-shell {
      -webkit-backdrop-filter: blur(30px) saturate(210%) brightness(1.04);
      align-items: center;
      backdrop-filter: blur(30px) saturate(210%) brightness(1.04);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.76) 0%, rgba(255, 255, 255, 0.48) 55%, rgba(241, 255, 246, 0.62) 100%);
      border: 1px solid rgba(255, 255, 255, 0.55);
      border-radius: 999px;
      box-shadow:
        0 20px 50px -12px rgba(7, 56, 38, 0.14),
        0 4px 14px rgba(7, 56, 38, 0.06),
        var(--glass-inset);
      display: flex;
      gap: 20px;
      height: 60px;
      justify-content: space-between;
      margin: 0 auto;
      max-width: 1080px;
      padding: 0 10px 0 14px;
      transition:
        height 360ms var(--spring-smooth),
        max-width 380ms var(--spring-smooth),
        background 280ms ease,
        box-shadow 320ms ease,
        transform 340ms var(--spring-elastic);
    }

    .site-header.is-scrolled .nav-shell {
      -webkit-backdrop-filter: blur(36px) saturate(225%) brightness(1.05);
      backdrop-filter: blur(36px) saturate(225%) brightness(1.05);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.84) 0%, rgba(255, 255, 255, 0.58) 55%, rgba(241, 255, 246, 0.72) 100%);
      box-shadow:
        0 24px 60px -14px rgba(7, 56, 38, 0.18),
        0 6px 18px rgba(7, 56, 38, 0.08),
        var(--glass-inset);
      height: 54px;
      max-width: 1036px;
    }

    .brand {
      align-items: center;
      display: inline-flex;
      gap: 10px;
      font-size: 0.92rem;
      font-weight: 700;
      min-width: 0;
      position: relative;
      white-space: nowrap;
      z-index: 1;
    }

    .brand-logo {
      align-items: center;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(241, 255, 246, 0.78));
      border: 1px solid rgba(6, 37, 27, 0.08);
      border-radius: 50%;
      box-shadow:
        0 4px 12px rgba(7, 56, 38, 0.1),
        inset 0 1px 1px rgba(255, 255, 255, 0.95);
      display: inline-flex;
      flex: 0 0 34px;
      height: 34px;
      justify-content: center;
      overflow: hidden;
      padding: 3px;
      width: 34px;
    }

    .brand-logo img {
      height: 100%;
      object-fit: contain;
      width: 100%;
    }

    .hero-logo {
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      background: var(--glass-bg-strong);
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 28px;
      box-shadow:
        0 24px 56px -14px rgba(7, 56, 38, 0.16),
        0 8px 20px -6px rgba(200, 40, 112, 0.08),
        var(--glass-inset);
      display: block;
      margin-bottom: 22px;
      padding: 14px;
      transition: transform 380ms var(--spring-elastic), box-shadow 320ms ease;
      width: 122px;
    }

    .hero-logo:hover {
      box-shadow:
        0 28px 64px -14px rgba(7, 56, 38, 0.2),
        0 10px 26px -6px rgba(200, 40, 112, 0.12),
        var(--glass-inset);
      transform: translateY(-4px) scale(1.03);
    }

    .hero-logo img {
      height: auto;
      position: relative;
      width: 100%;
      z-index: 1;
    }

    .nav-links {
      align-items: center;
      color: var(--muted);
      display: flex;
      font-size: 0.88rem;
      gap: 4px;
      position: relative;
      z-index: 1;
    }

    .nav-links a {
      border-radius: 999px;
      font-weight: 600;
      padding: 9px 14px;
      transition:
        background 220ms ease,
        color 200ms ease,
        box-shadow 220ms ease,
        transform 260ms var(--spring-elastic);
      white-space: nowrap;
    }

    .nav-links a:hover,
    .nav-links a:focus-visible {
      background: linear-gradient(145deg, rgba(222, 248, 234, 0.85), rgba(255, 255, 255, 0.72));
      box-shadow:
        0 4px 12px rgba(7, 56, 38, 0.08),
        inset 0 1px 1px rgba(255, 255, 255, 0.95);
      color: var(--green-900);
      outline: none;
      transform: translateY(-1px);
    }

    .nav-links a:active {
      transform: scale(0.96);
    }

    .language-toggle {
      -webkit-backdrop-filter: blur(14px);
      align-items: center;
      backdrop-filter: blur(14px);
      background: rgba(6, 37, 27, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.65);
      border-radius: 999px;
      box-shadow:
        inset 0 1px 3px rgba(6, 37, 27, 0.08),
        0 1px 0 rgba(255, 255, 255, 0.75);
      display: inline-flex;
      gap: 3px;
      padding: 3px;
      position: relative;
      z-index: 1;
    }

    .language-toggle.has-pill::before {
      background: linear-gradient(155deg, rgba(10, 75, 50, 0.95), rgba(6, 37, 27, 0.98));
      border-radius: 999px;
      box-shadow:
        0 6px 16px rgba(6, 37, 27, 0.24),
        inset 0 1px 1px rgba(255, 255, 255, 0.34);
      content: "";
      height: calc(100% - 6px);
      left: 0;
      pointer-events: none;
      position: absolute;
      top: 3px;
      transform: translateX(var(--pill-x, 3px));
      transition: transform 380ms var(--spring-elastic), width 320ms var(--spring-smooth);
      width: var(--pill-w, 38px);
      z-index: 0;
    }

    .lang-option {
      background: transparent;
      border: 0;
      border-radius: 999px;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      font-size: 0.78rem;
      font-weight: 800;
      min-height: 30px;
      padding: 0 10px;
      position: relative;
      transition: background 180ms ease, color 220ms ease, box-shadow 180ms ease, transform 240ms var(--spring-elastic);
      z-index: 1;
    }

    .lang-option:active {
      transform: scale(0.94);
    }

    .lang-option.is-active {
      background: linear-gradient(155deg, rgba(10, 75, 50, 0.95), rgba(6, 37, 27, 0.98));
      box-shadow:
        0 6px 16px rgba(6, 37, 27, 0.24),
        inset 0 1px 1px rgba(255, 255, 255, 0.34);
      color: var(--white);
    }

    .language-toggle.has-pill .lang-option.is-active {
      background: transparent;
      box-shadow: none;
    }

    .lang-option:focus-visible {
      outline: 2px solid var(--pink-500);
      outline-offset: 2px;
    }

    .button {
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      align-items: center;
      backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.45);
      border-radius: 999px;
      display: inline-flex;
      font-size: 0.88rem;
      font-weight: 700;
      gap: 8px;
      justify-content: center;
      min-height: 44px;
      overflow: hidden;
      padding: 0 20px;
      position: relative;
      transition:
        background 240ms ease,
        border-color 240ms ease,
        color 220ms ease,
        box-shadow 260ms ease,
        transform 340ms var(--spring-elastic);
      white-space: nowrap;
    }

    .button::after {
      background: linear-gradient(110deg, transparent 22%, rgba(255, 255, 255, 0.38) 50%, transparent 78%);
      content: "";
      inset: 0;
      pointer-events: none;
      position: absolute;
      transform: translateX(-120%);
      transition: transform 620ms var(--spring-smooth);
    }

    .button:hover::after {
      transform: translateX(120%);
    }

    .button.primary {
      background: linear-gradient(155deg, rgba(10, 75, 50, 0.92) 0%, rgba(6, 37, 27, 0.96) 100%);
      border-color: rgba(255, 255, 255, 0.22);
      box-shadow:
        0 14px 32px -10px rgba(6, 37, 27, 0.42),
        0 4px 12px rgba(6, 37, 27, 0.18),
        inset 0 1.5px 1px rgba(255, 255, 255, 0.36),
        inset 0 -1.5px 2px rgba(0, 0, 0, 0.25);
      color: var(--white);
    }

    .button.secondary {
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.48) 100%);
      border-color: rgba(255, 255, 255, 0.75);
      box-shadow:
        0 14px 30px -12px rgba(7, 56, 38, 0.16),
        0 4px 10px rgba(7, 56, 38, 0.06),
        var(--glass-inset);
      color: var(--green-900);
    }

    .button:hover {
      transform: translateY(-2px) scale(1.018);
    }

    .button:active {
      transform: translateY(0) scale(0.965);
    }

    .button.primary:hover {
      background: linear-gradient(155deg, rgba(240, 82, 146, 0.92) 0%, rgba(200, 40, 112, 0.96) 100%);
      border-color: rgba(255, 255, 255, 0.35);
      box-shadow:
        0 16px 34px -10px rgba(200, 40, 112, 0.44),
        0 4px 12px rgba(200, 40, 112, 0.2),
        inset 0 1.5px 1px rgba(255, 255, 255, 0.45);
    }

    .button.secondary:hover {
      background: linear-gradient(145deg, rgba(255, 231, 241, 0.85) 0%, rgba(255, 255, 255, 0.65) 100%);
      border-color: rgba(240, 82, 146, 0.35);
      box-shadow:
        0 16px 34px -12px rgba(200, 40, 112, 0.2),
        var(--glass-inset);
      color: var(--pink-700);
    }

    main {
      overflow: hidden;
    }

    .page-shell {
      margin: 0 auto;
      max-width: 1180px;
      padding: 0 24px;
    }

    .hero {
      padding: 132px 0 74px;
      position: relative;
    }

    .hero::before {
      background: linear-gradient(90deg, rgba(32, 168, 107, 0.14), rgba(240, 82, 146, 0.16), rgba(255, 255, 255, 0));
      content: "";
      height: 1px;
      left: 50%;
      max-width: 1040px;
      position: absolute;
      top: 102px;
      transform: translateX(-50%);
      width: calc(100% - 48px);
    }

    .hero-content {
      align-items: center;
      display: flex;
      flex-direction: column;
      margin: 0 auto;
      max-width: 860px;
      text-align: center;
    }

    .eyebrow,
    .section-kicker {
      align-items: center;
      color: var(--green-800);
      display: inline-flex;
      font-size: 0.78rem;
      font-weight: 800;
      gap: 8px;
      text-transform: uppercase;
    }

    .eyebrow {
      -webkit-backdrop-filter: var(--glass-blur-soft);
      backdrop-filter: var(--glass-blur-soft);
      background: var(--glass-bg);
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 999px;
      box-shadow:
        0 14px 36px -10px rgba(7, 56, 38, 0.12),
        var(--glass-inset);
      padding: 9px 15px;
    }

    .eyebrow > * {
      position: relative;
      z-index: 1;
    }

    .status-dot {
      animation: status-pulse 1.8s ease-out infinite;
      background: var(--pink-500);
      border-radius: 50%;
      box-shadow: 0 0 0 5px rgba(240, 82, 146, 0.14);
      flex: 0 0 8px;
      height: 8px;
      min-height: 8px;
      min-width: 8px;
      width: 8px;
    }

    @keyframes status-pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(240, 82, 146, 0.36);
      }

      70%,
      100% {
        box-shadow: 0 0 0 7px rgba(240, 82, 146, 0);
      }
    }

    h1,
    h2,
    h3,
    p {
      margin: 0;
    }

    h1 {
      color: var(--green-950);
      font-size: 72px;
      font-weight: 760;
      line-height: 1.02;
      margin-top: 26px;
      max-width: 820px;
    }

    .hero-copy {
      color: var(--muted);
      font-size: 1.15rem;
      margin-top: 22px;
      max-width: 720px;
    }

    .hero-actions {
